import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:flutter/material.dart';

import '../services/commission_service.dart';
import '../services/exchange_rate_service.dart';

class CreateTransactionPage extends StatefulWidget {
  const CreateTransactionPage({super.key});

  @override
  State<CreateTransactionPage> createState() => _CreateTransactionPageState();
}

class _CreateTransactionPageState extends State<CreateTransactionPage> {
  final _customerNameCtrl = TextEditingController();
  final _customerPhoneCtrl = TextEditingController();
  final _amountCtrl = TextEditingController();
  final _noteCtrl = TextEditingController();

  String _serviceName = 'MonCash';
  String _paymentCurrency = 'MXN';

  double _rateToHTG = 0;
  double _transferHTG = 0;
  bool _saving = false;

  final List<String> _services = ['MonCash', 'NatCash', 'Minit Haiti', 'Pappadap'];
  final List<String> _currencies = ['MXN', 'USD', 'DOP', 'CLP', 'BRL', 'HTG'];

  double _toDouble(String v) {
    return double.tryParse(v.replaceAll(',', '.').trim()) ?? 0;
  }

  Future<void> _calculate() async {
    final amount = _toDouble(_amountCtrl.text);
    if (amount <= 0) {
      setState(() {
        _rateToHTG = 0;
        _transferHTG = 0;
      });
      return;
    }

    final rate = await ExchangeRateService.getRateToHTG(_paymentCurrency);

    setState(() {
      _rateToHTG = rate;
      _transferHTG = amount * rate;
    });
  }

  Future<void> _saveTransaction() async {
    if (_saving) return;

    final user = FirebaseAuth.instance.currentUser;
    if (user == null) return;

    final amount = _toDouble(_amountCtrl.text);
    if (amount <= 0) return;

    setState(() => _saving = true);

    try {
      final rate = await ExchangeRateService.getRateToHTG(_paymentCurrency);
      final transferHTG = amount * rate;

      final userDoc = await FirebaseFirestore.instance
          .collection('users')
          .doc(user.uid)
          .get();

      final userData = userDoc.data() ?? {};
      final enterpriseId = (userData['enterpriseId'] ?? 'ENT-001').toString();
      final staffName = (userData['name'] ?? user.email ?? user.uid).toString();

      final docRef = await FirebaseFirestore.instance.collection('transactions').add({
        'enterpriseId': enterpriseId,
        'staffUid': user.uid,
        'staffName': staffName,
        'staffRole': 'agent',

        'serviceName': _serviceName,

        'customerName': _customerNameCtrl.text.trim(),
        'customerPhone': _customerPhoneCtrl.text.trim(),

        'paymentAmount': amount,
        'paymentCurrency': _paymentCurrency,

        'exchangeRateToHTG': rate,
        'transferAmount': transferHTG,
        'transferAmountHTG': await ExchangeRateService.convertToHTG(amount: paymentAmount, currency: paymentCurrency),
        'agentCommissionPercent': 10,
        'ownerCommissionPercent': 20,
        'commissionApplied': false,
        'transferCurrency': 'HTG',

        'agentCommissionPercent': 10,
        'ownerCommissionPercent': 20,
        'commissionApplied': false,

        'status': 'delivered',
        'paymentStatus': 'paid',

        'notes': _noteCtrl.text.trim(),

        'createdAt': FieldValue.serverTimestamp(),
        'updatedAt': FieldValue.serverTimestamp(),
      });

      await CommissionService.applyCommission(docRef.id);

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Transaction fèt: ${transferHTG.toStringAsFixed(2)} HTG',
          ),
        ),
      );

      Navigator.pop(context);
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Erreur: $e')),
      );
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  @override
  void dispose() {
    _customerNameCtrl.dispose();
    _customerPhoneCtrl.dispose();
    _amountCtrl.dispose();
    _noteCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final amount = _toDouble(_amountCtrl.text);
    final agentCom = amount * 0.10;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Nouvo Transaction'),
        centerTitle: true,
      ),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          DropdownButtonFormField<String>(
            value: _serviceName,
            decoration: const InputDecoration(labelText: 'Sevis'),
            items: _services
                .map((s) => DropdownMenuItem(value: s, child: Text(s)))
                .toList(),
            onChanged: (v) => setState(() => _serviceName = v ?? 'MonCash'),
          ),
          const SizedBox(height: 12),

          TextField(
            controller: _customerNameCtrl,
            decoration: const InputDecoration(labelText: 'Non kliyan'),
          ),
          const SizedBox(height: 12),

          TextField(
            controller: _customerPhoneCtrl,
            decoration: const InputDecoration(labelText: 'Telefòn kliyan / reseptè'),
            keyboardType: TextInputType.phone,
          ),
          const SizedBox(height: 12),

          Row(
            children: [
              Expanded(
                child: TextField(
                  controller: _amountCtrl,
                  decoration: const InputDecoration(labelText: 'Montan kliyan peye'),
                  keyboardType: TextInputType.number,
                  onChanged: (_) => _calculate(),
                ),
              ),
              const SizedBox(width: 12),
              SizedBox(
                width: 110,
                child: DropdownButtonFormField<String>(
                  value: _paymentCurrency,
                  decoration: const InputDecoration(labelText: 'Deviz'),
                  items: _currencies
                      .map((c) => DropdownMenuItem(value: c, child: Text(c)))
                      .toList(),
                  onChanged: (v) async {
                    setState(() => _paymentCurrency = v ?? 'MXN');
                    await _calculate();
                  },
                ),
              ),
            ],
          ),

          const SizedBox(height: 18),

          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                children: [
                  _line('Rate', _rateToHTG <= 0 ? '-' : '1 $_paymentCurrency = ${_rateToHTG.toStringAsFixed(2)} HTG'),
                  const Divider(),
                  _line('Kliyan ap resevwa', '${_transferHTG.toStringAsFixed(2)} HTG'),
                  const Divider(),
                  _line('Komisyon Agent', '${agentCom.toStringAsFixed(2)} $_paymentCurrency (10%)'),
                ],
              ),
            ),
          ),

          const SizedBox(height: 12),

          TextField(
            controller: _noteCtrl,
            decoration: const InputDecoration(labelText: 'Nòt'),
            maxLines: 2,
          ),

          const SizedBox(height: 24),

          ElevatedButton.icon(
            onPressed: _saving ? null : _saveTransaction,
            icon: _saving
                ? const SizedBox(
                    width: 18,
                    height: 18,
                    child: CircularProgressIndicator(strokeWidth: 2),
                  )
                : const Icon(Icons.save),
            label: Text(_saving ? 'Ap save...' : 'Save Transaction'),
          ),
        ],
      ),
    );
  }

  Widget _line(String label, String value) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(label),
        Flexible(
          child: Text(
            value,
            textAlign: TextAlign.right,
            style: const TextStyle(fontWeight: FontWeight.bold),
          ),
        ),
      ],
    );
  }
}
