PORT=4500
SMTP_USER=
SMTP_PASS=
OTP_TTL_SECONDS=300
# --- Imel (OTP) ---
# Konfigirasyon aktyel la se Gmail (SMTP_USER pi wo a se yon @gmail.com),
# e li detekte otomatikman. Pou pase sou Hostinger, dekomante youn nan 2 blòk yo.

# Opsyon 1 — Hostinger SMTP (pò 465 SSL; si li bloke, sèvi ak 587 + SMTP_SECURE=false)
# MAIL_PROVIDER=hostinger_smtp
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@domenn-ou.com
# SMTP_PASS=
# MAIL_FROM_NAME=VOUPVAPCASH

# Opsyon 2 — Hostinger Mail API (HTTP; travay kote pò SMTP yo bloke)
# MAIL_PROVIDER=hostinger_api
# HOSTINGER_MAIL_TOKEN=
# HOSTINGER_MAILBOX_ID=
# MAIL_FROM_NAME=VOUPVAPCASH

# Sekrè HMAC pou hash OTP yo (OBLIGATWA an pwodiksyon, min. 32 karaktè)
# Jenere: openssl rand -hex 32
OTP_SECRET=
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Bazik (MonCash / NatCash) ---
BAZIK_MODE=sandbox
BAZIK_BASE_URL=https://api.bazik.io
BAZIK_USER_ID=
BAZIK_SECRET_KEY=
BAZIK_WEBHOOK_SECRET=
WALLET_CURRENCY=USD

# --- Pwodiksyon ---
# Orijin ki gen dwa rele API a, separe pa vigil (vid = tout).
# Ak Docker, app la ak API a sou menm orijin: mete URL piblik la.
CORS_ORIGINS=
# Serveur a refize demare an pwodiksyon si pasrèl la an mòd `fake`.
# Mete true SÈLMAN pou yon demo san vre kòb.
ALLOW_FAKE_GATEWAY=false
