# Variables de docker compose (copier en `.env` à la racine).
# Les secrets de l'application (Bazik, SMTP, OTP) ne vont PAS ici :
# ils restent dans server/.env (modèle : server/.env.example).

# Version taguée sur les images construites.
APP_VERSION=1.0.0

# Adresse et port où `web` écoute sur l'hôte.
# 127.0.0.1 = accessible seulement depuis la machine (derrière un proxy TLS).
# 0.0.0.0   = accessible depuis le réseau, en HTTP clair : à éviter en production.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Domaine public, utilisé seulement avec : docker compose --profile tls up -d
DOMAIN=app.exemple.com

# Laisser vide : l'app appelle l'API sur sa propre origine.
# À renseigner seulement si l'API est servie sur un autre domaine.
API_BASE_URL=

# Fichier de secrets du serveur (par défaut server/.env).
# API_ENV_FILE=server/.env
