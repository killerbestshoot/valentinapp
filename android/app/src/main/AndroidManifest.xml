<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Obligatwa pou app la pale ak sèvè a (voupvapcash.com). Modèl Flutter la
         mete l sèlman nan debug/profile: san li, APK release la pa t ka konekte. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="VOUPVAPCASH"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- Android 11+: url_launcher bezwen deklare ki lyen li louvri (https). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
